generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AIConversation {
  id        String      @id
  title     String?
  userId    String
  createdAt DateTime    @default(now())
  updatedAt DateTime
  User      User        @relation(fields: [userId], references: [id])
  AIMessage AIMessage[]
}

model AIMessage {
  id             String         @id
  role           String
  content        String
  conversationId String
  createdAt      DateTime       @default(now())
  AIConversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model BibleBook {
  id               String           @id
  name             String
  order            Int
  translationId    String
  BibleTranslation BibleTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  BibleChapter     BibleChapter[]
}

model BibleChapter {
  id         String       @id
  number     Int
  bookId     String
  BibleBook  BibleBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  BibleVerse BibleVerse[]
}

model BibleTranslation {
  id        String      @id
  name      String
  code      String      @unique
  createdAt DateTime    @default(now())
  BibleBook BibleBook[]
}

model BibleVerse {
  id           String       @id
  number       Int
  text         String
  chapterId    String
  BibleChapter BibleChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model Category {
  id        String    @id
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime
  Content   Content[]
}

model Content {
  id          String        @id
  title       String
  slug        String        @unique
  type        ContentType
  status      ContentStatus @default(DRAFT)
  summary     String?
  body        String
  scripture   String?
  imageUrl    String?
  language    LanguageCode  @default(ENGLISH)
  authorId    String?
  categoryId  String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  User        User?         @relation(fields: [authorId], references: [id])
  Category    Category?     @relation(fields: [categoryId], references: [id])
}

model Devotion {
  id        String   @id
  title     String
  scripture String
  message   String
  prayer    String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model User {
  id             String           @id
  email          String           @unique
  fullName       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  password       String?
  language       LanguageCode     @default(ENGLISH)
  role           UserRole         @default(MEMBER)
  AIConversation AIConversation[]
  Content        Content[]
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  DEVOTION
  BIBLE_VIBE
  PRAYER
  SUNDAY_SCHOOL
  SERMON
}

enum LanguageCode {
  ENGLISH
  YORUBA
  IGBO
  HAUSA
  PIDGIN
  FRENCH
}

enum UserRole {
  ADMIN
  PASTOR
  TEACHER
  MEMBER
  GUEST
}
