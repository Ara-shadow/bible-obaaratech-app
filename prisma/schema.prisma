generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model AIConversation {
  id        String      @id
  title     String?
  userId    String
  createdAt DateTime    @default(now())
  updatedAt DateTime @updatedAt
  User      User        @relation(fields: [userId], references: [id])
  AIMessage AIMessage[]
}

model AIMessage {
  id             String         @id
  role           String
  content        String
  conversationId String
  createdAt      DateTime       @default(now())
  AIConversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model BibleBook {
  id               String           @id
  name             String
  order            Int
  translationId    String
  BibleTranslation BibleTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  BibleChapter     BibleChapter[]
}

model BibleChapter {
  id         String       @id
  number     Int
  bookId     String
  BibleBook  BibleBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  BibleVerse BibleVerse[]
}

model BibleTranslation {
  id        String      @id
  name      String
  code      String      @unique
  createdAt DateTime    @default(now())
  BibleBook BibleBook[]
}

model BibleVerse {
  id             String           @id
  number         Int
  text           String
  chapterId      String
  BibleChapter   BibleChapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sourceRefs     CrossReference[] @relation("SourceVerse")
  targetRefs     CrossReference[] @relation("TargetVerse")
}

model CrossReference {
  id            String     @id
  sourceVerseId String
  targetVerseId String
  source        String?

  sourceVerse   BibleVerse @relation("SourceVerse", fields: [sourceVerseId], references: [id], onDelete: Cascade)
  targetVerse   BibleVerse @relation("TargetVerse", fields: [targetVerseId], references: [id], onDelete: Cascade)

  @@index([sourceVerseId])
  @@index([targetVerseId])
}

model Story {
  id          String   @id
  title       String
  body        String
  ageRange    String?
  moralLesson String?
  prayer      String?
  activity    String?
  imageUrl    String?
  language    String   @default("en")
  published   Boolean  @default(false)
  questions   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([createdAt])
}

model BibleVibe {
  id          String   @id
  publishDate DateTime
  reflection  String
  imageUrl    String?
  language    String   @default("en")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishDate])
  @@index([published])
}

model Category {
  id        String    @id
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
 updatedAt DateTime @updatedAt
  Content   Content[]
}

model Content {
  id          String        @id
  title       String
  slug        String        @unique
  type        ContentType
  status      ContentStatus @default(DRAFT)
  summary     String?
  body        String
  scripture   String?
  imageUrl    String?
  language    LanguageCode  @default(ENGLISH)
  authorId    String?
  categoryId  String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
 updatedAt DateTime @updatedAt
  User        User?         @relation(fields: [authorId], references: [id])
  Category    Category?     @relation(fields: [categoryId], references: [id])
}

model Devotion {
  id        String   @id
  title     String
  scripture String
  message   String
  prayer    String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}

model User {
  id             String           @id
  email          String           @unique
  fullName       String?
  createdAt      DateTime         @default(now())
updatedAt DateTime @updatedAt
  password       String?
  language       LanguageCode     @default(ENGLISH)
  role           UserRole         @default(MEMBER)
  AIConversation AIConversation[]
  Content        Content[]
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  DEVOTION
  BIBLE_VIBE
  PRAYER
  SUNDAY_SCHOOL
  SERMON
}

enum LanguageCode {
  ENGLISH
  YORUBA
  IGBO
  HAUSA
  PIDGIN
  FRENCH
}

enum UserRole {
  ADMIN
  PASTOR
  TEACHER
  MEMBER
  GUEST
}
