# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bible_ai?schema=public"

# API
PORT=4000
FRONTEND_ORIGIN="https://bible.obaaratech.com.ng"
JWT_SECRET="generate-a-long-random-secret-at-least-32-characters"
COOKIE_SECURE="true"

# Admin
ADMIN_USERNAME="admin"
# Generate with: npm run admin:hash -- "your-strong-password"
ADMIN_PASSWORD_HASH=""

# AI provider (server-side only)
AI_API_URL="https://api.openai.com/v1/chat/completions"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_ENABLED="false"

# Frontend: leave empty when frontend and API share the same origin.
# For a separate API subdomain, set e.g. https://api.bible.obaaratech.com.ng
VITE_API_URL=""
